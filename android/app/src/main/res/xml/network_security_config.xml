<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Android.
  Blocks cleartext (HTTP) traffic and enforces certificate pinning.
  Critical for production security — prevents MITM attacks.
-->
<network-security-config>
    <!-- Block cleartext HTTP in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only for development API endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>  <!-- Android emulator localhost -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- Production API with certificate pinning -->
    <domain-config>
        <domain includeSubdomains="true">api.yourapp.com</domain>
        <pin-set expiration="2025-12-31">
            <pin digest="SHA-256">YOUR_PRODUCTION_PIN_HERE=</pin>
            <pin digest="SHA-256">YOUR_BACKUP_PIN_HERE=</pin>
        </pin-set>
    </domain-config>
</network-security-config>